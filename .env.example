# Copy this file to .env for local development.
# Never commit real credentials, cookies, auth state, or private account data.

# LiteLLM provider keys. Fill only the providers you use.
GEMINI_API_KEY=
GROQ_API_KEY=

# Local/private fallback model served by Ollama.
OLLAMA_MODEL=ollama/qwen2.5:7b

# SQLite database path.
TRAVEL_AGENT_DB=travel_agent.sqlite

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
